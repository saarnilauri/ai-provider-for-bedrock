{
    "name": "saarnilauri/ai-provider-for-bedrock",
    "description": "Amazon Bedrock Claude provider for WordPress AI Client",
    "version": "0.1.0",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.1",
        "aws/aws-sdk-php": "^3.0"
    },
    "require-dev": {
        "symfony/dotenv": "^6.4 || ^7.2",
        "phpunit/phpunit": "^10.0",
        "phpstan/phpstan": "^2.0",
        "squizlabs/php_codesniffer": "^3.7",
        "wordpress/php-ai-client": "^1.2"
    },
    "autoload": {
        "psr-4": {
            "AiProviderForBedrock\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AiProviderForBedrock\\Tests\\Unit\\": "tests/unit/",
            "AiProviderForBedrock\\Tests\\Integration\\": "tests/integration/"
        }
    },
    "scripts": {
        "test": "@test:unit",
        "test:unit": "phpunit --testsuite unit --bootstrap tests/unit/bootstrap.php",
        "test:integration": "phpunit --testsuite integration --bootstrap tests/integration/bootstrap.php"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "platform": {
            "php": "8.1.99"
        }
    }
}
