{
    "name": "saarnilauri/ai-provider-for-bedrock",
    "description": "Amazon Bedrock Claude provider for WordPress AI Client",
    "version": "1.0.0",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.1",
        "aws/aws-sdk-php": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "phpstan/phpstan": "^2.0",
        "squizlabs/php_codesniffer": "^3.7",
        "wordpress/php-ai-client": "^1.2"
    },
    "autoload": {
        "psr-4": {
            "AiProviderForBedrock\\": "src/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
