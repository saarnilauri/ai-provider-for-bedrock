# Credentials for integration tests (composer test:integration).
# Configure EITHER a Bedrock API key OR an IAM access key pair.

# Option 1: Amazon Bedrock API key (sent as a Bearer token).
# Generate in the Bedrock console under "API keys".
BEDROCK_API_KEY=

# Option 2: IAM access key pair (requests signed with AWS Signature V4).
# The IAM user/role needs the bedrock:InvokeModel permission.
BEDROCK_ACCESS_KEY_ID=
BEDROCK_SECRET_ACCESS_KEY=

# AWS region to use (defaults to eu-north-1).
BEDROCK_REGION=eu-north-1
