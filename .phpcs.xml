<?xml version="1.0"?>
<ruleset name="AI Provider for Bedrock">
    <description>Coding standards for AI Provider for Bedrock plugin.</description>

    <file>src/</file>
    <file>plugin.php</file>

    <exclude-pattern>vendor/*</exclude-pattern>
    <exclude-pattern>tests/*</exclude-pattern>

    <rule ref="PSR12"/>

    <!--
     The main plugin file must both declare symbols and have side effects
     (WordPress plugin bootstrap pattern), so this sniff cannot apply to it.
    -->
    <rule ref="PSR1.Files.SideEffects.FoundWithSymbols">
        <exclude-pattern>plugin.php</exclude-pattern>
    </rule>

    <arg name="colors"/>
    <arg value="sp"/>
</ruleset>
